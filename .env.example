# Copy to .env in the repo root. docker compose reads it.

# MySQL root. The Go service still connects as root (see backend/.env).
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=events_db

# Password for the `panel` MySQL user that db/panel-db.sh creates. The same
# value goes into admin/.env as DB_PASSWORD. Generate one with:
#   openssl rand -hex 24
PANEL_DB_PASSWORD=
