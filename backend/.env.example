# Copy to backend/.env. godotenv/autoload reads it from the working
# directory, so the API must be started from backend/.

# Same values as the repo-root .env that docker compose reads.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=events_db

# Shared secret for the read endpoints (GET /api/v1/events...). The panel
# sends it as "Authorization: Bearer <key>"; admin/.env must hold the same
# value. Generate one with: openssl rand -hex 32
EVENTS_API_KEY=
