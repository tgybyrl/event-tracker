# Copy to backend/.env. godotenv/autoload reads it from the working
# directory, so the API must be started from backend/.

# Same values as the repo-root .env that docker compose reads.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=events_db

# Shared secret for the read endpoints (GET /api/v1/events...). The panel
# sends it as "Authorization: Bearer <key>"; admin/.env must hold the same
# value. Generate one with: openssl rand -hex 32
EVENTS_API_KEY=

# Addresses allowed to set X-Forwarded-For, i.e. the reverse proxy in front
# of the API. Comma-separated. Empty means 127.0.0.1,::1 (Caddy on Docker
# Desktop reaches the host from there).
TRUSTED_PROXIES=

# Where Redis listens (host:port). Empty means 127.0.0.1:6379, the port
# docker compose publishes on this machine. The API and cmd/worker both
# read it.
REDIS_ADDR=

# The clock the dashboard counts in: where "today" starts and which hour an
# event falls into. Stored timestamps stay UTC. Empty means Europe/Istanbul.
DISPLAY_TIMEZONE=
